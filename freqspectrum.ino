// FFT library options
// See http://wiki.openmusiclabs.com/wiki/Defines if you're curious.
#define FFT_N 16 // you can change this if you like - see the note in setLEDs.
                 // (you might consider changing it to 64)
#define WINDOW 0
#define OCTAVE 1
#define OCT_NORM 0
#include <FFT.h>

const byte SAMPLE_PERIOD_MICROSECONDS = 250;
const byte ANODE_PINS[8] = {6, 7, 8, 9, 10, 11, 12, 13}; 
const byte CATHODE_PINS[8] = {A3, A2, A1, A0, 5, 4, 3, 2}; 
const byte AUDIO_INPUT_PIN = A4;  

void setup() {
  
  for (byte i = 0; i < 8; i++) {
    pinMode(ANODE_PINS[i], OUTPUT);
    pinMode(CATHODE_PINS[i], OUTPUT);

    // Turn all 16 control pins off
    digitalWrite(ANODE_PINS[i], HIGH);
    digitalWrite(CATHODE_PINS[i], HIGH);
  }
  
  pinMode(AUDIO_INPUT_PIN, INPUT);
  Serial.begin(115200);
}

/* Function: display
 * -----------------
 * Runs through one multiplexing cycle of the LEDs, controlling which LEDs are
 * on.
 *
 * During this function, LEDs that should be on will be turned on momentarily,
 * one row at a time. When this function returns, all the LEDs will be off
 * again, so it needs to be called continuously for LEDs to be on.
 */
void display(byte pattern[8][8]) {
    // for each anode (+/row) wire
  for (byte row = 0; row < 8; row++) {

   // for each cathode (-/column) wire
   for (byte col = 0; col < 8; col++) {

    if (pattern[row][col] == 1) { // LED at this position is ON
      // if LED should be on, activate cathode (-) wire
      digitalWrite(CATHODE_PINS[col], LOW);
    } else { // else deactivate it
      digitalWrite(CATHODE_PINS[col], HIGH);
    }

   }
    // activate anode (+) wire
    digitalWrite(ANODE_PINS[row], LOW);

    // wait a short time
    delayMicroseconds(100);

    // deactivate anode (+) wire
    digitalWrite(ANODE_PINS[row], HIGH);
  }
  
  // reset columns by turning them all off 
  for (byte col = 0; col < 8; col++) {
    digitalWrite(CATHODE_PINS[col], HIGH);
  }
}

/* Function: getSamples
 * --------------------
 * Populates every other element of an array with FFT_N samples, sampled at
 * 1000/SAMPLE_PERIOD_MICROSECONDS kHz. Takes about 6.7ms to run.
 */
void getSamples(int samples[FFT_N*2]) {
  unsigned long next_sample_time = micros();
  for (byte i = 0; i < FFT_N*2; i+=2) {
    while (micros() < next_sample_time); // wait till next sample time
    unsigned long value = analogRead(AUDIO_INPUT_PIN);
    samples[i] = value - 464;   // average value of biasing circuit = 464
    samples[i+1] = 0;
    next_sample_time += SAMPLE_PERIOD_MICROSECONDS;
  }
}

/* Function: printBins
 * ------------------- 
 * Prints the contents of the fft_oct_out bins to the Serial Monitor.
 * Assumes that LOG_N == 4; change this is that's not the case.
 */
void printBins(byte bins[LOG_N]) {
  static char message[20];
  sprintf(message, "%3d %3d %3d %3d\n", fft_oct_out[0], fft_oct_out[1], fft_oct_out[2], fft_oct_out[3]);
  Serial.print(message);
}

/* Function: shiftLeft
* --------------------
* Shifts the prior LED display left to create the visual of moving
* LED lights to represent the music history.
*/
void shiftLeft(byte pattern[8][8]) {
  for (byte row = 0; row < 8; row++) {
    for (byte col = 0; col < 7; col++) {
      pattern[row][col] = pattern[row][col+1]; // shift existing pattern left
    }
    pattern[row][7] = 0; // clear what was on rightmost column after shifting
  }
}

/* Function: drawStar
* -------------------
* Draws a star centered at (centerRow, centerCol)
* and extends according to size parameter
*/
void drawStar(byte pattern[8][8], byte centerRow, byte centerCol, byte size) {
  pattern[centerRow][centerCol] = 1; // turn on center of star
  for (byte radius = 1; radius <= size; radius++) {
    // extend star upwards
    if (centerRow >= radius) { // only turn LEDs on if still in bounds
      pattern[centerRow - radius][centerCol] = 1;
    }
    
    // extend star downwards
    if (centerRow + radius < 8) { // only turn LEDs on if still in bounds
      pattern[centerRow + radius][centerCol] = 1;
    }

    // extend star to the right
    if (centerCol + radius < 8) { // only turn LEDs on if still in bounds
      pattern[centerRow][centerCol + radius] = 1; 
    }

    // extend star to the left
    if (centerCol >= radius) { // only turn LEDs on if still in bounds
      pattern[centerRow][centerCol - radius] = 1; 
    }
  }
}


/* Function: setLEDs
 * -----------------
 * Sets the LEDs array based on the given frequency bin values. The bins are
 * assumed to be of the form generated by fft_mag_octave() of the ArduinoFFT
 * library.
 *
 * LOG_N is defined in FFT.h as log2(FFT_N), so if FFT_N = 16, LOG_N = 4.
 * ------------------
 * Create scrolling star pattern based on input music. Louder frequencies
 * correspond to larger stars.
 */
void setLEDs(byte pattern[8][8], byte bins[LOG_N]) {
  static unsigned long prior = 0; // remember prior update time
  
  // wait 230 ms before scrolling/creating new stars, otherwise pattern moves too fast
  if (millis() - prior < 230) {
    return;
  }

  prior = millis(); // update time since last pattern update

  shiftLeft(pattern); // move old pattern left

  const byte MIN = 40; // minimum magnitude to draw star, otherwise too many stars drawn

  // find the bin with highest magnitude,
  // only the bin with the highest magnitude will be drawn each time
  // i.e. only one star (corresponding to the loudest frequency) will be drawn each update to avoid cluttering
  byte maxBin = 0;
  for (byte i = 1; i < 4; i++) { // check each bin to find the maxBin
    if (bins[i] > bins[maxBin]) {
      maxBin = i;
    }
  }

  // if the maxBin isn't loud enough, no star will be drawn, but existing pattern still shifts left
  if (bins[maxBin] < MIN) {
    return;
  }

  // convert maxBin magnitude into star size:
  // since we cannot use the raw magnitude given by the maxBin since it will be too large
  // we will divide the magnitude by 50; however, we will also constrain the divided value between (1,2)
  // in case the raw divided value is too small (0) or too large to fit into the LED board
  byte starSize = constrain(bins[maxBin] / 50, 1, 2);

  // draw stars:
  // bass stars drawn near the bottom, sopranos near the top

  // draw bass star
  if (maxBin == 0) {
    drawStar(pattern, 6, 6, starSize); // stars are created at column 6 so that they aren't cut off too much
  } 

  // draw tenor star
  else if (maxBin == 1) {
    drawStar(pattern, 4, 6, starSize);
  } 

  // draw alto star
  else if (maxBin == 2) {
    drawStar(pattern, 2, 6, 1);
  } 

  // draw soprano star
  else {
    drawStar(pattern, 0, 6, 1);
  }
}

void loop() {
  static byte pattern[8][8];

  getSamples(fft_input);

  // These three functions run the FFT on the data in the global array
  // fft_input. The result will be in the global array fft_oct_out. If you're
  // curious, you can look at http://wiki.openmusiclabs.com/wiki/FFTFunctions
  // for other variants of these functions to use instead.
  fft_reorder();
  fft_run();
  fft_mag_octave();

  printBins(fft_oct_out);
  setLEDs(pattern, fft_oct_out);
  display(pattern);
}
